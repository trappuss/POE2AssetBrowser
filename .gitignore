# Build output / deps
build/
dist/
vcpkg_installed/
*.obj
*.exe
*.dll
*.pdb
*.ilk
.publish.cfg.bak

# The tool's portable data folder (settings, index cache, thumbnails, logs) — generated at runtime.
data/

