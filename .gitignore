# Reference-parser scratch (the Python oracle's extracted corpus is large and disposable).
tools/formats/__pycache__/
tools/formats/*.raw
tools/formats/corpus/

# No game assets or keys, ever.
*.dds
*.smd
*.fmt
*.ast
*.mat
